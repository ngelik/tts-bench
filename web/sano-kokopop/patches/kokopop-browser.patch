diff --git a/src/backend/webgpu.cpp b/src/backend/webgpu.cpp
index c8f6351..e346b02 100644
--- a/src/backend/webgpu.cpp
+++ b/src/backend/webgpu.cpp
@@ -14,0 +15,2 @@
+#include <map>
+#include <string>
@@ -27,0 +30 @@ class WebGPUBackend final : public SchedBackendBase {
+    std::map<std::string, uint64_t> gpu_op_assignments_;
@@ -88,0 +92,34 @@ public:
+    void reset_webgpu_op_assignments() override {
+        gpu_op_assignments_.clear();
+    }
+
+    std::string webgpu_op_assignments_json() const override {
+        std::string json = "{";
+        bool first = true;
+        for (const auto & [name, count] : gpu_op_assignments_) {
+            if (!first) json += ",";
+            first = false;
+            json += "\"" + name + "\":" + std::to_string(count);
+        }
+        json += "}";
+        return json;
+    }
+
+    ggml_status compute(ggml_context * ctx, ggml_cgraph * graph) override {
+        GGML_ASSERT(sched_ != nullptr && "compute called before sched_alloc_graph");
+        GGML_ASSERT(graph != nullptr);
+        for (int i = 0; i < ggml_graph_n_nodes(graph); ++i) {
+            ggml_tensor * node = ggml_graph_node(graph, i);
+            if (ggml_backend_sched_get_tensor_backend(sched_, node) != backend_) {
+                continue;
+            }
+            const char * op_name = node->op == GGML_OP_UNARY
+                ? ggml_unary_op_name(ggml_get_unary_op(node))
+                : ggml_op_name(node->op);
+            if (op_name != nullptr) {
+                ++gpu_op_assignments_[op_name];
+            }
+        }
+        return SchedBackendBase::compute(ctx, graph);
+    }
+
diff --git a/src/kokopop.cpp b/src/kokopop.cpp
index 443bc7e..a17cdc6 100644
--- a/src/kokopop.cpp
+++ b/src/kokopop.cpp
@@ -615,0 +616,14 @@ int32_t kokopop_model_backend(const kokopop_model * model) {
+void kokopop_model_reset_webgpu_op_assignments(kokopop_model * model) {
+    if (model && model->impl && model->impl->backend) {
+        model->impl->backend->reset_webgpu_op_assignments();
+    }
+}
+
+const char * kokopop_model_webgpu_op_assignments_json(const kokopop_model * model) {
+    static thread_local std::string json;
+    json = model && model->impl && model->impl->backend
+        ? model->impl->backend->webgpu_op_assignments_json()
+        : "{}";
+    return json.c_str();
+}
+
