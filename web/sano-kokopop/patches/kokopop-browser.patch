--- a/src/backend/backend.h
+++ b/src/backend/backend.h
@@ -114,0 +115,6 @@ struct Backend {
+    // Benchmark-only introspection hooks. Backends may expose the operation
+    // types the scheduler actually assigned to their device for recent graph
+    // executions. The default CPU implementation has no device assignments.
+    virtual void reset_webgpu_op_assignments() {}
