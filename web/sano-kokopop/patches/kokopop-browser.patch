+/// Benchmark telemetry: reset and read the ggml graph nodes scheduled onto
+/// the WebGPU backend since the previous reset. CPU assignments are omitted.
+KOKOPOP_API void kokopop_model_reset_webgpu_op_assignments(kokopop_model * model);
+KOKOPOP_API const char * kokopop_model_webgpu_op_assignments_json(const kokopop_model * model);
