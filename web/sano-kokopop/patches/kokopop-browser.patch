+EMSCRIPTEN_KEEPALIVE kokopop_audio * kp_synthesize_seeded(
+    kokopop_model * model, const char * text, const char * voice, float speed, uint32_t seed) {
+    try {
+        kokopop_synthesis_options options{};
+        options.voice = voice;
+        options.speed = speed;
+        options.mode = KOKOPOP_SYNTH_LONG_FORM;
+        options.has_sano_noise_seed = 1;
+        options.sano_noise_seed = seed;
+
+        kokopop_synthesis * raw_synthesis = nullptr;
+        if (kokopop_synthesis_create(model, &options, &raw_synthesis) != KOKOPOP_OK) {
+            return nullptr;
+        }
+        const auto free_synthesis = [](kokopop_synthesis * value) { kokopop_synthesis_free(value); };
+        std::unique_ptr<kokopop_synthesis, decltype(free_synthesis)> synthesis(raw_synthesis, free_synthesis);
+        auto audio = std::make_unique<kokopop_audio>();
+        std::vector<float> samples;
+        int sample_rate = 0;
+        bool final_chunk = false;
+        if (kokopop_synthesis_push_text(synthesis.get(), text) != KOKOPOP_OK ||
+            kokopop_synthesis_finish_input(synthesis.get()) != KOKOPOP_OK) {
+            return nullptr;
+        }
+
+        struct AudioChunksDeleter {
+            size_t count;
+            void operator()(kokopop_audio_chunk * value) const {
+                kokopop_audio_chunks_free(value, count);
+            }
+        };
+        while (!final_chunk) {
+            kokopop_audio_chunk * chunks = nullptr;
+            size_t n_chunks = 0;
+            const int result = kokopop_synthesis_next(synthesis.get(), 1, &chunks, &n_chunks);
+            std::unique_ptr<kokopop_audio_chunk, AudioChunksDeleter> owned_chunks(
+                chunks, AudioChunksDeleter{n_chunks});
+            if (result != KOKOPOP_OK || n_chunks == 0) return nullptr;
+            for (size_t i = 0; i < n_chunks; ++i) {
+                if (chunks[i].sample_rate <= 0 ||
+                    (sample_rate != 0 && chunks[i].sample_rate != sample_rate) ||
+                    (chunks[i].n_samples != 0 && chunks[i].samples == nullptr)) {
+                    return nullptr;
+                }
+                sample_rate = chunks[i].sample_rate;
+                if (chunks[i].n_samples != 0) {
+                    samples.insert(samples.end(), chunks[i].samples,
+                                   chunks[i].samples + chunks[i].n_samples);
+                }
+                final_chunk = chunks[i].is_final != 0;
+            }
+        }
+        if (samples.empty() || sample_rate <= 0) return nullptr;
+
+        audio->samples = static_cast<float *>(std::malloc(samples.size() * sizeof(float)));
+        if (audio->samples == nullptr) return nullptr;
+        std::memcpy(audio->samples, samples.data(), samples.size() * sizeof(float));
+        audio->n_samples = samples.size();
+        audio->sample_rate = sample_rate;
+        return audio.release();
+    } catch (...) {
+        return nullptr;
+    }
+}
+
 EMSCRIPTEN_KEEPALIVE const float * kp_samples(kokopop_audio * audio) { return audio->samples; }
