diff --git a/web/worker.js b/web/worker.js
index 2a33c4e..f03d99f 100644
--- a/web/worker.js
+++ b/web/worker.js
@@ -7,0 +8,25 @@ let queue = Promise.resolve();
+function observeComputeDispatches() {
+  let count = 0;
+  let stopped = false;
+  const original = [];
+  const prototype = globalThis.GPUComputePassEncoder?.prototype;
+  for (const name of ['dispatchWorkgroups', 'dispatchWorkgroupsIndirect']) {
+    if (typeof prototype?.[name] !== 'function') continue;
+    const method = prototype[name];
+    original.push([prototype, name, method]);
+    prototype[name] = function (...args) {
+      count++;
+      return method.apply(this, args);
+    };
+  }
+  return {
+    stop() {
+      if (!stopped) {
+        for (const [proto, name, method] of original) proto[name] = method;
+        stopped = true;
+      }
+      return count;
+    },
+  };
+}
