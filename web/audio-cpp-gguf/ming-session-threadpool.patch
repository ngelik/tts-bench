+#if defined(__EMSCRIPTEN__) && defined(__EMSCRIPTEN_PTHREADS__)
+class MingWasmCpuThreadPool {
+public:
+    explicit MingWasmCpuThreadPool(const core::ExecutionContext & execution)
+        : backend_(execution.backend()) {
+        if (backend_ == nullptr || !ggml_backend_is_cpu(backend_)) {
+            return;
+        }
+
+        // ExecutionContext leaves GGML's backend default in place for nonpositive counts.
+        const int requested = execution.config().threads;
+        const int threads = requested > 0 ? requested : GGML_DEFAULT_N_THREADS;
+        if (threads > GGML_MAX_N_THREADS) {
+            throw std::invalid_argument("Ming CPU thread count exceeds GGML_MAX_N_THREADS");
+        }
+        auto params = ggml_threadpool_params_default(threads);
+        pool_ = ggml_threadpool_new(&params);
+        if (pool_ == nullptr) {
+            throw std::runtime_error("Ming CPU thread pool creation failed");
+        }
+        ggml_backend_cpu_set_threadpool(backend_, pool_);
+    }
+
+    ~MingWasmCpuThreadPool() {
+        if (pool_ != nullptr) {
+            ggml_backend_cpu_set_threadpool(backend_, nullptr);
+            ggml_threadpool_free(pool_);
+        }
+    }
+
+    MingWasmCpuThreadPool(const MingWasmCpuThreadPool &) = delete;
+    MingWasmCpuThreadPool & operator=(const MingWasmCpuThreadPool &) = delete;
+
+private:
+    ggml_backend_t backend_;
+    ggml_threadpool_t pool_ = nullptr;
+};
+#endif
